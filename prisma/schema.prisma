generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DroneState {
  IDLE
  LOADING
  LOADED
  DELIVERING
  DELIVERED
  RETURNING

  @@map("drone_state")
}

model Drone {
  id             String     @id @default(uuid(7)) @db.Uuid
  serialNumber   String     @unique @map("serial_number") @db.VarChar(100)
  model          String     @db.VarChar(32)
  weightLimitMg  Int        @map("weight_limit_mg")
  loadedWeightMg Int        @default(0) @map("loaded_weight_mg")
  batteryPct     Int        @map("battery_pct")
  state          DroneState @default(IDLE)
  retiredAt      DateTime?  @map("retired_at") @db.Timestamptz(3)
  retiredReason  String?    @map("retired_reason") @db.VarChar(255)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries       Delivery[]
  batteryAuditLogs BatteryAuditLog[]

  @@map("drones")
}

model Medication {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(100)
  weightMg  Int      @map("weight_mg")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveryItems DeliveryItem[]

  @@map("medications")
}

model Delivery {
  id       String    @id @default(uuid(7)) @db.Uuid
  droneId  String    @map("drone_id") @db.Uuid
  openedAt DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt DateTime? @map("closed_at") @db.Timestamptz(3)

  drone Drone          @relation(fields: [droneId], references: [id], onDelete: NoAction)
  items DeliveryItem[]

  @@map("deliveries")
}

model DeliveryItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  deliveryId   String   @map("delivery_id") @db.Uuid
  medicationId String   @map("medication_id") @db.Uuid
  quantity     Int
  unitWeightMg Int      @map("unit_weight_mg")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery   Delivery   @relation(fields: [deliveryId], references: [id], onDelete: NoAction)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: NoAction)

  @@index([deliveryId])
  @@map("delivery_items")
}

model IdempotencyKey {
  key          String   @id @db.VarChar(255)
  requestHash  String   @map("request_hash") @db.Char(64)
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("idempotency_keys")
}

model BatteryAuditLog {
  id         BigInt     @id @default(autoincrement())
  droneId    String     @map("drone_id") @db.Uuid
  batteryPct Int        @map("battery_pct")
  droneState DroneState @map("drone_state")
  isLow      Boolean    @map("is_low")
  checkedAt  DateTime   @map("checked_at") @db.Timestamptz(3)

  drone Drone @relation(fields: [droneId], references: [id], onDelete: NoAction)

  @@index([droneId, checkedAt(sort: Desc), id(sort: Desc)])
  @@map("battery_audit_logs")
}
